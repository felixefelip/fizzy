module ColumnsHelper
  def button_to_set_column: (Card & Card::Validated card, (Column & Column::Validated) column) -> untyped
  def column_tag: (id: ("closed-cards" | "not-now" | "maybe"), name: ("Done" | "Not Now" | "Maybe?"), drop_url: String, ?collapsed: false, ?selected: "true"?, ?card_color: untyped, ?data: ({ card_hotkeys_disabled: true, drag_and_strum_target: "container", collapsible_columns_target: "column", action: "focus->collapsible-columns#focusOnColumn" } | { drag_and_strum_target: "container", collapsible_columns_target: "column", controller: "clicker", action: "turbo:before-stream-render@document->collapsible-columns#restoreState focus->collapsible-columns#focusOnColumn dialog:show->collapsible-columns#frameColumnOnMobile" } | { card_hotkeys_disabled: true, collapsible_columns_target: "column", drag_and_strum_target: "container", action: "focus->collapsible-columns#focusOnColumn" } | { drag_and_strum_target: "container", collapsible_columns_target: "column maybeColumn", action: "focus->collapsible-columns#focusOnColumn" }), **untyped) ?{ (*untyped) -> nil } -> untyped
  def column_frame_tag: ((:closed_column | :not_now_column | :stream_column) id, ?src: String?, ?data: untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
end
