module WebhooksHelper
  ACTION_LABELS: ActiveSupport::HashWithIndifferentAccess[Symbol, String]

  def webhook_action_options: (?[ "card_assigned", "card_closed", "card_postponed", "card_auto_postponed", "card_board_changed", "card_published", "card_reopened", "card_sent_back_to_triage", "card_triaged", "card_unassigned", "comment_created" ] actions) -> untyped
  def webhook_action_label: (untyped action) -> untyped
  def link_to_webhooks: ((Board | (Board & Board::Validated))? board) ?{ (*untyped) -> untyped } -> untyped
end
