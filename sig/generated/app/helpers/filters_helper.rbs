module FiltersHelper
  def filter_chip_tag: (String text, untyped params) -> untyped
  def filter_hidden_field_tag: (untyped key, untyped value) -> untyped
  def filter_selected_boards_title: (untyped user_filtering) -> untyped
  def filter_place_menu_item: (untyped path, String label, String icon, ?new_window: untyped, ?current: untyped, ?turbo: bool) -> untyped
  def filter_dialog: (String label) ?{ (untyped) -> untyped } -> untyped
  def filter_title: (String title) -> untyped
  def collapsible_nav_section: (String title, **untyped) ?{ (untyped) -> untyped } -> untyped
  def filter_hotkey_link: (String title, untyped path, Integer key, String icon) -> untyped
  def sorted_by_label: (untyped sort_value) -> String
end
