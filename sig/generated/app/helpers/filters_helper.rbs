module FiltersHelper
  def filter_chip_tag: (String text, Hash[untyped, untyped] params) -> untyped
  def filter_hidden_field_tag: (untyped key, String value) -> untyped
  def filter_selected_boards_title: (untyped user_filtering) -> untyped
  def filter_place_menu_item: (String path, String label, String icon, ?new_window: untyped, ?current: bool, ?turbo: bool) -> untyped
  def filter_dialog: (String label) ?{ (*untyped) -> (User::ActiveRecord_Relation | Board::ActiveRecord_Relation | Array[String] | Tag::ActiveRecord_Relation) } -> untyped
  def filter_title: (String title) -> untyped
  def collapsible_nav_section: (String title, **untyped) { (untyped) -> (Account::ActiveRecord_Relation | Board::ActiveRecord_Relation | String | User::ActiveRecord_Relation | Tag::ActiveRecord_Relation) } -> untyped
  def filter_hotkey_link: (String title, String path, Integer key, String icon) -> untyped
  def sorted_by_label: (String sort_value) -> String
end
