module PaginationHelper
  def pagination_frame_tag: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) namespace, untyped page, ?data: untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
  def link_to_next_page: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) namespace, untyped page, ?activate_when_observed: true, ?label: untyped, ?data: untyped, **untyped) -> untyped
  def pagination_link: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) namespace, untyped page_number, ?activate_when_observed: true, ?label: untyped, ?url_params: untyped, ?data: untyped, **untyped) -> untyped
  def pagination_frame_id_for: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) namespace, untyped page_number) -> String
  def with_manual_pagination: (untyped name, untyped page, **untyped) { () -> untyped } -> untyped
  def with_automatic_pagination: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) name, untyped page, **untyped) { () -> nil } -> untyped
  def day_timeline_pagination_frame_tag: (User::DayTimeline day_timeline) ?{ (*untyped) -> nil } -> untyped
  def day_timeline_pagination_frame_id_for: ((ActiveSupport::TimeWithZone | bool | ActiveSupport::TimeWithZone?) day) -> String
  def day_timeline_pagination_link: (User::DayTimeline day_timeline, (Filter & Filter::Validated | Filter) filter) -> untyped

  private

  def pagination_list: ((:closed_column | :not_now_column | :stream_column | :filtered_cards_paginated_container | "maybe" | :cards_paginated_container | :filtered_search_results) name, ?tag_element: untyped, ?paginate_on_scroll: true, **untyped) ?{ (*untyped) -> untyped } -> untyped
  def default_pagination_label: (true activate_when_observed) -> "Load more…"
end
