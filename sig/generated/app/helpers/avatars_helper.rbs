module AvatarsHelper
  def avatar_background_color: (untyped user) -> untyped
  def avatar_tag: (((User & User::Validated) | (User & User::Validated)?) user, ?hidden_for_screen_reader: (bool | { tabindex: untyped } | { aria: { label: String } }), **untyped) -> untyped
  def avatar_tags: (untyped users, **untyped) -> untyped
  def mail_avatar_tag: (untyped user, ?size: untyped, **untyped) -> untyped
  def avatar_preview_tag: (User & User::Validated user, ?hidden_for_screen_reader: (bool | { tabindex: untyped }), **untyped) -> untyped
  def avatar_image_tag: (((User & User::Validated)? | User & User::Validated) user, **untyped) -> untyped
end
