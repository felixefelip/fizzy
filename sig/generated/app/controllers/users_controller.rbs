class UsersController < ApplicationController
  @user: (User & User::Validated)?

  def index: () -> void
  def show: () -> void
  def edit: () -> void
  def update: () -> void
  def destroy: () -> void

  private

  def set_user: () -> (User & User::Validated)
  def ensure_permission_to_change_user: () -> bool?
  def user_params: () -> untyped
end
