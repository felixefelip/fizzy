module Cards
  class StepsController < ApplicationController
    @step: (Step | (Step & Step::Validated))?

    include CardScoped

    def index: () -> void
    def create: () -> void
    def show: () -> void
    def edit: () -> void
    def update: () -> void
    def destroy: () -> void

    private

    def set_step: () -> (Step & Step::Validated)
    def step_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
  end
end
