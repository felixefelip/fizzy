module Cards
  module Comments
    class ReactionsController < ApplicationController
      @reaction: Reaction?
      @comment: (Comment & Comment::Validated)?
      @reactable: (Comment & Comment::Validated)?

      include CardScoped

      def index: () -> void
      def new: () -> void
      def create: () -> void
      def destroy: () -> void

      private

      def set_comment: () -> (Comment & Comment::Validated)
      def set_reactable: () -> (Comment & Comment::Validated)
      def set_reaction: () -> Reaction?
      def ensure_permission_to_administer_reaction: () -> bool?
    end
  end
end
