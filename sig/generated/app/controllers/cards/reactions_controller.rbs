module Cards
  class ReactionsController < ApplicationController
    @reactable: (Card & Card::Validated)?

    include CardScoped

    def index: () -> void
    def new: () -> void
    def create: () -> void
    def destroy: () -> void

    private

    def set_reactable: () -> (Card & Card::Validated)
    def set_reaction: () -> untyped
    def ensure_permission_to_administer_reaction: () -> bool?
  end
end
