module Cards
  class CommentsController < ApplicationController
    @comment: (Comment | (Comment & Comment::Validated))?

    include CardScoped

    def index: () -> void
    def create: () -> void
    def show: () -> void
    def edit: () -> void
    def update: () -> void
    def destroy: () -> void

    private

    def set_comment: () -> (Comment & Comment::Validated)
    def ensure_creatorship: () -> bool?
    def ensure_card_is_commentable: () -> bool?
    def comment_params: () -> untyped
  end
end
