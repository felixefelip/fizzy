module Authentication
  module ClassMethods
    def require_unauthenticated_access: (**untyped) -> void
    def allow_unauthenticated_access: (**untyped) -> untyped
    def disallow_account_scope: (**untyped) -> void
  end

  extend ActiveSupport::Concern
  include ::Authentication::ViaMagicLink
  include LoginHelper

  private

  def authenticated?: () -> bool
  def require_account: () -> bool?
  def require_authentication: () -> { httponly: bool, same_site: Symbol, value: String }
  def resume_session: () -> { httponly: bool, same_site: Symbol, value: String }?
  def find_session_by_cookie: () -> (Session & Session::Validated)?
  def authenticate_by_bearer_token: () -> void
  def bearer_token_authenticatable_request?: () -> untyped
  def request_authentication: () -> bool
  def after_authentication_url: () -> untyped
  def redirect_authenticated_user: () -> bool?
  def redirect_tenanted_request: () -> bool?
  def start_new_session_for: (untyped identity) -> untyped
  def set_current_session: ((Session & Session::Validated) session) -> { value: String, httponly: bool, same_site: Symbol }
  def terminate_session: () -> untyped
  def session_token: () -> untyped
end
