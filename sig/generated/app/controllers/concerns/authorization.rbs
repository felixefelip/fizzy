module Authorization
  extend ActiveSupport::Concern
  def allow_unauthorized_access: (**untyped) -> untyped
  def require_access_without_a_user: (**untyped) -> untyped

  private

  def ensure_admin: () -> true?
  def ensure_staff: () -> true?
  def authenticated_account_access?: () -> untyped
  def ensure_can_access_account: () -> untyped
  def redirect_existing_user: () -> untyped
end
