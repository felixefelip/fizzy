module FilterScoped
  @filter: ((Filter & Filter::Validated) | Array[Filter])?
  @user_filtering: User::Filtering?

  extend ActiveSupport::Concern

  private

  def set_filter: () -> ((Filter & Filter::Validated) | Array[Filter])
  def filter_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
  def set_user_filtering: () -> User::Filtering
  def expanded_param: () -> untyped
end
