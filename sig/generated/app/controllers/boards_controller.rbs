class BoardsController < ApplicationController
  @board: (Board | (Board & Board::Validated))?

  include FilterScoped

  def index: () -> void
  def show: () -> void
  def new: () -> void
  def create: () -> void
  def edit: () -> void
  def update: () -> void
  def destroy: () -> void

  private

  def set_board: () -> (Board & Board::Validated)
  def ensure_permission_to_admin_board: () -> bool?
  def grantees_changed?: () -> bool
  def show_filtered_cards: () -> untyped
  def show_columns: () -> untyped
  def board_params: () -> (ActionController::Parameters & ActionController::Parameters::Permitted)
  def grantees: () -> User::ActiveRecord_Relation
  def revokees: () -> Board_User::ActiveRecord_Associations_CollectionProxy
  def grantee_ids: () -> untyped
end
