class ApplicationPlatform < PlatformAgent
  def ios?: () -> bool
  def android?: () -> bool
  def mac?: () -> bool
  def chrome?: () -> untyped
  def edge?: () -> untyped
  def firefox?: () -> untyped
  def safari?: () -> untyped
  def mobile?: () -> bool
  def desktop?: () -> bool
  def native?: () -> bool
  def windows?: () -> bool
  def bridge_name: () -> (:android | :ios | nil)
  def bridge_components: () -> ""
  def type: () -> ("native android" | "native ios" | "mobile web" | "desktop web")
  def operating_system: () -> ("Android" | "iPad" | "iPhone" | "macOS" | "Windows" | "ChromeOS" | "Linux")

  private

  def extract_list_from_native_user_agent: ("bridge-components" prefix) -> ""

  class AfterWindows
    def operating_system: () -> "Windows"
  end
end
