class ApplicationPlatform < PlatformAgent
  def ios?: () -> bool
  def android?: () -> bool
  def mac?: () -> bool
  def chrome?: () -> untyped
  def edge?: () -> untyped
  def firefox?: () -> untyped
  def safari?: () -> untyped
  def mobile?: () -> bool
  def desktop?: () -> bool
  def native?: () -> bool
  def windows?: () -> bool
  def bridge_name: () -> Symbol?
  def bridge_components: () -> String
  def type: () -> String
  def operating_system: () -> String

  private

  def extract_list_from_native_user_agent: (String prefix) -> String
end
