class ZipFile
  def create_for: (ActiveStorage::Attached::One attachment, filename: String) -> untyped
  def read_from: (untyped blob) -> untyped

  private

  def s3_service?: (untyped service) -> untyped
  def create_for_s3: (untyped attachment, filename: untyped, service: untyped) -> untyped
  def create_for_disk: (untyped attachment, filename: untyped) -> untyped
  def read_from_s3: (untyped blob) -> untyped
  def read_from_disk: (untyped blob) -> untyped
end
