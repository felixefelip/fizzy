class ZipFile
  def self.create_for: (ActiveStorage::Attached::One attachment, filename: String) ?{ (ZipFile::Writer) -> untyped } -> untyped
  def self.read_from: (untyped blob) ?{ (ZipFile::Reader) -> untyped } -> untyped
  def self.s3_service?: (untyped service) -> untyped
  def self.create_for_s3: (ActiveStorage::Attached::One attachment, filename: String, service: untyped) { (ZipFile::Writer) -> untyped } -> untyped
  def self.create_for_disk: (ActiveStorage::Attached::One attachment, filename: String) { (ZipFile::Writer) -> untyped } -> untyped
  def self.read_from_s3: (untyped blob) { (ZipFile::Reader) -> untyped } -> untyped
  def self.read_from_disk: (untyped blob) { (ZipFile::Reader) -> untyped } -> untyped
end

class ZipFile
  class InvalidFileError < StandardError
  end
end
