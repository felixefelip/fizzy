class Signup
  @tenant: nil
  include ActiveModel::Model
  include ActiveModel::Attributes
  extend ActiveModel::Attributes::ClassMethods
  include ActiveModel::Validations
  extend ActiveModel::Validations::ClassMethods
  attr_accessor full_name: untyped
  attr_accessor email_address: untyped
  attr_accessor identity: Identity & Identity::Validated
  attr_accessor skip_account_seeding: untyped
  attr_reader account: self
  attr_reader user: nil
  def initialize: (**untyped) -> void
  def create_identity: () -> MagicLink
  def complete: () -> bool

  private

  def create_tenant: () -> nil
  def handle_account_creation_error: (untyped error) -> untyped
  def create_account: () -> untyped
  def generate_account_name: () -> String
  def destroy_account: () -> nil
  def subscription_attributes: () -> Hash[untyped, untyped]
  def request_attributes: () -> Hash[untyped, untyped]

  class AfterCreateAccount
    attr_reader account: singleton(Account)
  end

  class AfterDestroyAccount
    attr_reader account: nil
  end

  class AfterInitialize
    attr_reader email_address: String?
  end
end
