class Webhook < ApplicationRecord
  SLACK_WEBHOOK_URL_REGEX: Regexp
  CAMPFIRE_WEBHOOK_URL_REGEX: Regexp
  BASECAMP_CAMPFIRE_WEBHOOK_URL_REGEX: Regexp
  PERMITTED_SCHEMES: [ "http", "https" ]
  PERMITTED_ACTIONS: [ "card_assigned", "card_closed", "card_postponed", "card_auto_postponed", "card_board_changed", "card_published", "card_reopened", "card_sent_back_to_triage", "card_triaged", "card_unassigned", "comment_created" ]

  include Triggerable

  def activate: () -> self?
  def deactivate: () -> self
  def renderer: () -> untyped
  def for_basecamp?: () -> bool
  def for_campfire?: () -> bool
  def for_slack?: () -> bool

  private

  def validate_url: () -> ActiveModel::Error?
end
