class ZipFile
  class Reader
    class IO
      @io: ZipFile::RemoteIO

      def initialize: (untyped entry, ZipFile::RemoteIO io) -> void
      def read: (?untyped length, ?untyped buffer) -> untyped
      def eof?: () -> untyped
      def rewind: () -> Integer
      def size: () -> untyped
    end
  end
end
