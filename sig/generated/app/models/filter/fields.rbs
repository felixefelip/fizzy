class Filter
  module Fields
    INDEXES: Array[("all" | "closed" | "not_now" | "stalled" | "postponing_soon" | "golden")]
    SORTED_BY: Array[("newest" | "oldest" | "latest")]

    extend ActiveSupport::Concern

    def with: (**untyped) -> ((Filter & Filter::Validated) | Filter)
    def default_indexed_by: () -> "all"
    def default_indexed_by?: () -> bool
    def default_sorted_by: () -> "latest"
    def default_sorted_by?: () -> bool
    def default_value?: (:indexed_by | :sorted_by key, untyped value) -> bool
  end
end

class Filter
  module Fields
    module ClassMethods
      def default_values: () -> { indexed_by: "all", sorted_by: "latest" }
      def default_value?: ((:indexed_by | :sorted_by) key, untyped value) -> bool
      def indexed_by_human_name: (("all" | "closed" | "not_now" | "stalled" | "postponing_soon" | "golden") index) -> String
    end
  end
end
