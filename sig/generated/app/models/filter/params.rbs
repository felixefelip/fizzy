class Filter
  module Params
    PERMITTED_PARAMS: Array[(Symbol | Hash[Symbol, Array[untyped]])]

    module ClassMethods
      def find_by_params: (untyped params) -> (Filter & Filter::Validated)?
      def digest_params: (untyped params) -> String
      def normalize_params: (untyped params) -> untyped
    end
    extend ActiveSupport::Concern
    def used?: (?ignore_boards: untyped) -> untyped
    def as_params: () -> Hash[untyped, untyped]
    def as_params_without: (untyped key, untyped value) -> Hash[untyped, untyped]
    def params_digest: () -> untyped
  end
end
