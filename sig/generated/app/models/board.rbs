class Board < ApplicationRecord
  extend ::Storage::Totaled::ClassMethods
  extend ::Board::Publishable::ClassMethods
  include Accessible
  include AutoPostponing
  include ::Board::Storage
  include Broadcastable
  include Cards
  include Entropic
  include Filterable
  include Publishable
  include ::Storage::Tracked
  include Triageable

  def public_description: () -> ActionText::RichText
  def public_description?: () -> bool
  def public_description=: (untyped body) -> untyped
  def auto_postpone_period: () -> Integer?
  def auto_postpone_period_in_days: () -> Integer

  class AfterPublicDescription
    def rich_text_public_description: () -> ::ActionText::RichText
  end
end
