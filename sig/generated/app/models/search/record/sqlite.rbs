module Search
  class Record
    module SQLite
      extend ActiveSupport::Concern
      def search_fields: (untyped query) -> Array[untyped]
      def for: (untyped account_id) -> Search::Record::Sqlite
      def card_title: () -> untyped
      def card_description: () -> untyped
      def comment_body: () -> untyped

      private

      def escape_fts_highlight: (untyped html) -> untyped
      def upsert_to_fts5_table: () -> untyped
    end
  end
end
