module Search
  class Query < ApplicationRecord
    def self.wrap: (untyped query) -> self
    def to_s: () -> untyped

    private

    def sanitize_terms: () -> String?
    def sanitize: (untyped terms) -> String?
    def remove_invalid_search_characters: (untyped terms) -> String
    def remove_unbalanced_quotes: (String terms) -> String
  end
end
