module Search
  class Highlighter
    OPENING_MARK: String
    CLOSING_MARK: String
    ELIPSIS: String
    attr_reader query: untyped
    def initialize: (untyped query) -> void
    def highlight: (untyped text) -> untyped
    def snippet: (untyped text, ?max_words: untyped) -> untyped

    private

    def terms: () -> untyped
    def escape_highlight_marks: (untyped html) -> untyped
  end
end
