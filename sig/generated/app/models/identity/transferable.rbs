class Identity
  module Transferable
    TRANSFER_LINK_EXPIRY_DURATION: ActiveSupport::Duration

    extend ActiveSupport::Concern

    def transfer_id: () -> String
  end
end

class Identity
  module Transferable
    module ClassMethods
      def find_by_transfer_id: (untyped id) -> (Identity & Identity::Validated)?
    end
  end
end
