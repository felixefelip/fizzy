class Event
  class Description
    include ActionView::Helpers::TagHelper
    include ERB::Util

    attr_reader event: Event
    attr_reader user: nil

    def initialize: (Event event, nil user) -> void
    def to_html: () -> ActiveSupport::SafeBuffer
    def to_plain_text: () -> ActiveSupport::SafeBuffer

    private

    def to_sentence: (String creator, String card_title) -> String?
    def creator_tag: () -> untyped
    def card_title_tag: () -> untyped
    def creator_name: () -> String
    def quoted: (untyped text) -> String
    def card: () -> untyped
    def comment_sentence: (String creator, String card_title) -> String
    def action_sentence: (String creator, String card_title) -> String?
    def assigned_sentence: (String creator, String card_title) -> String
    def unassigned_sentence: (String creator, String card_title) -> String
    def renamed_sentence: (String creator, String card_title) -> String
    def moved_sentence: (String creator, String card_title) -> String
    def triaged_sentence: (String creator, String card_title) -> String
    def assignee_names: () -> String
    def unassigned_names: () -> String
    def old_title: () -> String
    def new_location: () -> String
    def column: () -> String
  end
end
