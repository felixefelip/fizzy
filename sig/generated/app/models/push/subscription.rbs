module Push
  class Subscription < ApplicationRecord
    @endpoint_uri: (URI::File | URI::FTP | URI::HTTP | URI::HTTPS | URI::LDAP | URI::LDAPS | URI::MailTo | URI::WS | URI::WSS | URI::Generic)?

    PERMITTED_ENDPOINT_HOSTS: [ "jmt17.google.com", "fcm.googleapis.com", "updates.push.services.mozilla.com", "web.push.apple.com", "notify.windows.com" ]

    def notification: (**untyped) -> WebPush::Notification
    def resolved_endpoint_ip: () -> untyped

    private

    def endpoint_uri: () -> (URI::File | URI::FTP | URI::HTTP | URI::HTTPS | URI::LDAP | URI::LDAPS | URI::MailTo | URI::WS | URI::WSS | URI::Generic | nil)
    def validate_endpoint_url: () -> ActiveModel::Error?
    def permitted_endpoint_host?: () -> bool
  end
end
