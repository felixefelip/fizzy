module Push
  class Subscription < ApplicationRecord
    def notification: (**untyped) -> WebPush::Notification
    def resolved_endpoint_ip: () -> untyped

    private

    def endpoint_uri: () -> (URI::File | URI::FTP | URI::HTTP | URI::HTTPS | URI::LDAP | URI::LDAPS | URI::MailTo | URI::WS | URI::WSS | URI::Generic | nil)
    def validate_endpoint_url: () -> ActiveModel::Error?
    def permitted_endpoint_host?: () -> untyped
  end
end
