class Card < ApplicationRecord
  extend ::Card::Entropic::ClassMethods
  include Accessible
  include Assignable
  include Attachments
  include Broadcastable
  include Closeable
  include Colored
  include Commentable
  include Entropic
  include Eventable
  include Exportable
  include Golden
  include Mentions
  include Multistep
  include Pinnable
  include Postponable
  include Promptable
  include Readable
  include Searchable
  include Stallable
  include Statuses
  include Storage::Tracked
  include Taggable
  include Triageable
  include Watchable
  include ::Mentions
  include ::Searchable

  def card: () -> Card
  def to_param: () -> String
  def move_to: ((Board & Board::Validated) new_board) -> untyped
  def filled?: () -> untyped
  def mentionable?: () -> bool
  def should_check_mentions?: () -> bool
  def accessible_to?: () -> bool
  def auto_postpone_period: () -> Integer?

  private

  def set_default_title: () -> String?
  def handle_board_change: () -> untyped
  def track_board_change_event: (String? old_board_name) -> untyped
  def assign_number: () -> untyped
end
