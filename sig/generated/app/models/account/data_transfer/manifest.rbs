class Account
  module DataTransfer
    class Manifest
      attr_reader account: Account?

      def initialize: (Account? account) -> void
      def each_record_set: (?start: untyped) ?{ (*untyped) -> untyped } -> untyped

      private

      def record_sets: () -> untyped
      def record_sets_for: (*(singleton(::User::Settings) | singleton(::Tag) | singleton(::Board) | singleton(::Column) | singleton(::Board::Publication) | singleton(::Webhook) | singleton(::Access) | singleton(::Card) | singleton(::Comment) | singleton(::Step) | singleton(::Assignment) | singleton(::Tagging) | singleton(::Closure) | singleton(::Card::Goldness) | singleton(::Card::NotNow) | singleton(::Card::ActivitySpike) | singleton(::Watch) | singleton(::Pin) | singleton(::Reaction) | singleton(::Mention) | singleton(::Filter) | singleton(::Webhook::DelinquencyTracker) | singleton(::Event) | singleton(::Notification) | singleton(::Notification::Bundle) | singleton(::Webhook::Delivery)) models) -> Array[Account::DataTransfer::RecordSet]
      def record_set_for: ((singleton(::ActiveStorage::VariantRecord) | singleton(User::Settings) | singleton(Tag) | singleton(Board) | singleton(Column) | singleton(Board::Publication) | singleton(Webhook) | singleton(Access) | singleton(Card) | singleton(Comment) | singleton(Step) | singleton(Assignment) | singleton(Tagging) | singleton(Closure) | singleton(Card::Goldness) | singleton(Card::NotNow) | singleton(Card::ActivitySpike) | singleton(Watch) | singleton(Pin) | singleton(Reaction) | singleton(Mention) | singleton(Filter) | singleton(Webhook::DelinquencyTracker) | singleton(Event) | singleton(Notification) | singleton(Notification::Bundle) | singleton(Webhook::Delivery) | singleton(ActiveStorage::VariantRecord)) model) -> Account::DataTransfer::RecordSet
      def set_importable_model_names: (untyped record_sets) -> untyped
    end
  end
end
