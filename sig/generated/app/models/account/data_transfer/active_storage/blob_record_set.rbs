class Account
  module DataTransfer
    module ActiveStorage
      class BlobRecordSet < ::Account::DataTransfer::RecordSet
        def initialize: (Account? account) -> void

        private

        def records: () -> ActiveStorage::Blob::ActiveRecord_Relation
        def excluded_blob_ids: () -> ActiveStorage::Attachment::ActiveRecord_Relation
        def import_batch: (untyped files) -> untyped
      end
    end
  end
end
