class Account
  module DataTransfer
    class RecordSet
      IMPORT_BATCH_SIZE: Integer
      INTERNAL_RECORD_TYPES: Array[String]

      attr_accessor importable_model_names: untyped
      attr_reader account: Account?
      attr_reader model: singleton(ActiveStorage::VariantRecord)
      attr_reader attributes: untyped

      def initialize: (account: Account?, model: singleton(ActiveStorage::VariantRecord), ?attributes: untyped, ?importable_model_names: untyped) -> void
      def export: (to: untyped, ?start: untyped) -> ActiveStorage::VariantRecord::ActiveRecord_Relation?
      def import: (from: untyped, ?start: untyped, ?callback: untyped) -> ActiveStorage::VariantRecord::ActiveRecord_Relation?
      def check: (from: untyped, ?start: untyped, ?callback: untyped) -> ActiveStorage::VariantRecord::ActiveRecord_Relation?

      private

      attr_reader zip: untyped

      def with_zip: (untyped zip) { () -> ActiveStorage::VariantRecord::ActiveRecord_Relation? } -> ActiveStorage::VariantRecord::ActiveRecord_Relation?
      def records: () -> ActiveStorage::VariantRecord::ActiveRecord_Relation
      def export_record: (untyped record) -> untyped
      def files: () -> untyped
      def import_batch: (untyped files) -> untyped
      def check_record: (untyped file_path) -> Array[untyped]
      def check_associations_dont_exist: (untyped data) -> Array[untyped]
      def check_association_doesnt_exist: (untyped data, untyped association, untyped associated_id) -> untyped
      def verify_model_type: (untyped type_name) -> untyped
      def skip_to: (untyped file_list, untyped last_id) -> untyped
      def load: (untyped file_path) -> untyped
      def model_dir: () -> untyped
    end
  end
end

class Account
  module DataTransfer
    class RecordSet
      class IntegrityError < StandardError
      end
    end
  end
end

class Account
  module DataTransfer
    class RecordSet
      class ConflictError < IntegrityError
      end
    end
  end
end
