class Account
  class Seeder
    attr_reader account: (Account & Account::Seedeable)
    attr_reader creator: untyped

    def initialize: ((Account & Account::Seedeable) account, untyped creator) -> void
    def seed: () -> Card
    def seed!: () -> Card

    private

    def populate: () -> Card
    def delete_everything: () -> untyped
  end
end
