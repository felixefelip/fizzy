class Signup
  class AccountNameGenerator
    SUFFIX: String

    attr_reader identity: Identity
    attr_reader name: untyped
    def initialize: (identity: Identity, name: untyped) -> void
    def generate: () -> String

    private

    def current_index: () -> untyped
    def existing_indices: () -> untyped
    def first_account_name_regex: () -> Regexp
    def nth_account_name_regex: () -> Regexp
    def prefix: () -> String
    def first_name: () -> untyped

    class AfterInitialize
      attr_reader identity: (Identity & Identity::Validated)
    end
  end
end
