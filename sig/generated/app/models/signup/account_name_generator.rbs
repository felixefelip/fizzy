class Signup
  class AccountNameGenerator
    SUFFIX: untyped
    attr_reader identity: Identity & Identity::Validated
    attr_reader name: untyped
    def initialize: (identity: Identity & Identity::Validated, name: untyped) -> void
    def generate: () -> untyped

    private

    def current_index: () -> untyped
    def existing_indices: () -> untyped
