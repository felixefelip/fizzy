class Filter < ApplicationRecord
  extend ::Filter::Fields::ClassMethods
  extend ::Filter::Params::ClassMethods
  include Fields
  include Params
  include Resources
  include Summarized

  def self.from_params: ((ActionController::Parameters & ActionController::Parameters::Permitted) params) -> ((Filter & Filter::Validated) | Filter)
  def self.remember: (Hash[untyped, untyped] attrs) -> (Filter | Filter::Validated | nil)

  def cards: () -> untyped
  def empty?: () -> bool
  def single_board: () -> (Board & Board::Validated)?
  def single_workflow: () -> untyped
  def cacheable?: () -> bool
  def cache_key: () -> untyped
  def only_closed?: () -> untyped
  def assignment_status: () -> untyped
  def indexed_by: () -> untyped
  def sorted_by: () -> untyped
  def creation_window: () -> untyped
  def closure_window: () -> untyped
  def terms: () -> [ ]
  def terms=: (untyped value) -> untyped
  def column_ids: () -> Array[bot]
  def column_ids=: (untyped value) -> untyped

  private

  def include_closed_cards?: () -> untyped
  def include_not_now_cards?: () -> untyped
end
