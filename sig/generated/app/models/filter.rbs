class Filter < ApplicationRecord
  include Fields
  extend Fields::ClassMethods
  include Params
  extend Params::ClassMethods
  include Resources
  include Summarized

  def self.from_params: (untyped params) -> untyped
  def self.remember: (untyped attrs) -> Filter

  def cards: () -> untyped
  def empty?: () -> untyped
  def single_board: () -> (Board & Board::Validated)?
  def single_workflow: () -> untyped
  def cacheable?: () -> bool
  def cache_key: () -> untyped
  def only_closed?: () -> untyped

  private

  def include_closed_cards?: () -> untyped
  def include_not_now_cards?: () -> untyped
end
