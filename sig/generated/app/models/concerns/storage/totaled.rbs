module Storage
  module Totaled
    extend ActiveSupport::Concern

    def bytes_used: () -> Integer
    def bytes_used_exact: () -> BigDecimal
    def materialize_storage_later: () -> untyped
    def materialize_storage: () -> untyped
    def reconcile_storage: () -> untyped

    private

    def create_or_find_storage_total: () -> (Storage::Total | (Storage::Total & Storage::Total::Validated))
    def calculate_real_storage_bytes: () -> bot
  end
end

module Storage
  module Totaled
    module ClassMethods
      def foreign_key_for_storage: () -> String
    end
  end
end
