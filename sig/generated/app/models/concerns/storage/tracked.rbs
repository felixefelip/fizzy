module Storage
  module Tracked
    extend ActiveSupport::Concern
    def storage_tracked_record: () -> Storage::Tracked
    def board_for_storage_tracking: () -> untyped
    def storage_bytes: () -> untyped

    private

    def board_transfer?: () -> untyped
    def track_board_transfer: () -> Hash[untyped, Array[untyped]]?
    def storage_transfer_records: () -> Array[self]
    def attachments_for_storage: (?untyped recordable) -> Array[untyped]
    def storage_attachments_for_records: (Array[Storage::Tracked] recordables) -> Hash[untyped, Array[untyped]]
  end
end
