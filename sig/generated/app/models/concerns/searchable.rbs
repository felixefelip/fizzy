module Searchable
  SEARCH_CONTENT_LIMIT: untyped

  extend ActiveSupport::Concern

  def reindex: () -> untyped

  private

  def create_in_search_index: () -> untyped
  def update_in_search_index: () -> untyped
  def remove_from_search_index: () -> untyped
  def search_record_attributes: () -> { account_id: String?, board_id: String?, card_id: String?, content: untyped, created_at: ActiveSupport::TimeWithZone?, searchable_id: String?, searchable_type: String, title: String? }
  def search_record_content: () -> untyped
  def search_record_class: () -> untyped
end
