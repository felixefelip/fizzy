module Mentions
  extend ActiveSupport::Concern

  def create_mentions: (?mentioner: untyped) -> Array[untyped]
  def mentionable_content: () -> String
  def scan_mentionees: () -> Array[untyped]

  private

  def mentionees_from_attachments: () -> Array[untyped]
  def mentionable_users: () -> untyped
  def rich_text_associations: () -> Array[untyped]
  def should_create_mentions?: () -> bool
  def mentionable_content_changed?: () -> bool
  def create_mentions_later: () -> untyped
  def mentionable?: () -> bool
  def should_check_mentions?: () -> bool
end
