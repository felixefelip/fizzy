class Card
  module Assignable
    extend ActiveSupport::Concern
    def toggle_assignment: (untyped user) -> untyped
    def assigned_to?: (untyped user) -> untyped
    def assigned?: () -> untyped

    private

    def assign: (untyped user) -> untyped
    def unassign: (untyped user) -> untyped
  end
end
