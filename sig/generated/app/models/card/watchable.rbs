class Card
  module Watchable
    extend ActiveSupport::Concern

    def watched_by?: ((User & User::Validated) user) -> bool?
    def watch_for: ((User & User::Validated) user) -> (Watch & Watch::Validated)?
    def watch_by: (User? user) -> untyped
    def unwatch_by: (untyped user) -> untyped

    private

    def subscribe_creator: () -> untyped
  end
end
