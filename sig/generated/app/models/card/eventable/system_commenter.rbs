class Card
  module Eventable
    class SystemCommenter
      include ERB::Util

      attr_reader card: (Card & Card::Eventable)
      attr_reader event: untyped

      def initialize: ((Card & Card::Eventable) card, untyped event) -> void
      def comment: () -> Comment?

      private

      def comment_body: () -> String?
      def creator_name: () -> String
      def assignee_names: () -> String
      def old_title: () -> String
      def new_title: () -> String
      def old_board: () -> String
      def new_board: () -> String
      def column: () -> String
    end
  end
end
