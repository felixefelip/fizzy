class Card
  module Closeable
    extend ActiveSupport::Concern
    def closed?: () -> (true | false)
    def open?: () -> bool
    def closed_by: () -> User?
    def closed_at: () -> ActiveSupport::TimeWithZone?
    def close: (?user: untyped) -> untyped
    def reopen: (?user: untyped) -> untyped
  end
end
