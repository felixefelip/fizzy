class Card
  module Stallable
    @should_detect_activity_spikes: bool?
    extend ActiveSupport::Concern
    def stalled?: () -> untyped
    def last_activity_spike_at: () -> ActiveSupport::TimeWithZone?
    def detect_activity_spikes: () -> bool

    private

    def remember_to_detect_activity_spikes: () -> bool
    def should_detect_activity_spikes?: () -> bool?
    def detect_activity_spikes_later: () -> untyped
  end
end
