class Card
  class Entropy
    def self.for: ((Card & Card::Entropic) card) -> Card::Entropy?

    attr_reader card: untyped
    attr_reader auto_clean_period: untyped

    def initialize: (untyped card, untyped auto_clean_period) -> untyped
    def auto_clean_at: () -> ActiveSupport::TimeWithZone
    def days_before_reminder: () -> untyped
  end
end
