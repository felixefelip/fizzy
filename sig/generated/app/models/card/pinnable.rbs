class Card
  module Pinnable
    extend ActiveSupport::Concern
    def pinned_by?: (untyped user) -> bool
    def pin_for: (untyped user) -> (Pin & Pin::Validated)?
    def pin_by: (untyped user) -> (Pin & Pin::Validated)
    def unpin_by: (untyped user) -> Pin::Validated?

    private

    def broadcast_pin_updates: () -> untyped
  end
end
