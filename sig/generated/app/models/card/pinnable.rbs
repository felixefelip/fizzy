class Card
  module Pinnable
    extend ActiveSupport::Concern
    def pinned_by?: (untyped user) -> untyped
    def pin_for: (untyped user) -> untyped
    def pin_by: (untyped user) -> untyped
    def unpin_by: (untyped user) -> untyped

    private

    def broadcast_pin_updates: () -> untyped
  end
end
