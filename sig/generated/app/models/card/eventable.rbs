class Card
  module Eventable
    extend ActiveSupport::Concern
    include ::Eventable
    def event_was_created: (untyped event) -> untyped
    def touch_last_active_at: () -> self

    private

    def should_track_event?: () -> bool
    def track_title_change: () -> untyped
    def create_system_comment_for: (untyped event) -> untyped
  end
end
