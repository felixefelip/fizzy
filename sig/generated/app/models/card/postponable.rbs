class Card
  module Postponable
    extend ActiveSupport::Concern
    def postponed?: () -> untyped
    def postponed_at: () -> ActiveSupport::TimeWithZone?
    def postponed_by: () -> User?
    def active?: () -> untyped
    def auto_postpone: (**untyped) -> untyped
    def postpone: (?user: untyped, ?event_name: Symbol) -> untyped
    def resume: () -> untyped
  end
end
