class Card
  module Accessible
    extend ActiveSupport::Concern

    def publicly_accessible?: () -> untyped
    def clean_inaccessible_data: () -> untyped
    def accessible_to?: () -> bool

    private

    def grant_access_to_assignees: () -> untyped
    def clean_inaccessible_data_later: () -> untyped
  end
end
