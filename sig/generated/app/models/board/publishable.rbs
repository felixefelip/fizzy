class Board
  module Publishable
    extend ActiveSupport::Concern

    alias publicly_accessible? published?

    def published?: () -> bool
    def publish: () -> Board::Publication?
    def unpublish: () -> bool?
  end
end

class Board
  module Publishable
    module ClassMethods
      def find_by_published_key: (untyped key) -> (Board & Board::Validated)
    end
  end
end
