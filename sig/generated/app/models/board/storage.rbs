class Board
  module Storage
    @card_ids: Array[String]?

    BATCH_SIZE: 1000

    extend ActiveSupport::Concern
    include ::Storage::Totaled

    def board_for_storage_tracking: () -> self

    private

    def calculate_real_storage_bytes: () -> untyped
    def card_ids: () -> Array[String]
    def card_image_bytes: () -> untyped
    def card_embed_bytes: () -> untyped
    def comment_embed_bytes: () -> untyped
    def board_embed_bytes: () -> untyped
    def sum_embed_bytes_for: (("Card" | "Comment" | "Board") record_type, (Array[Integer] | Array[untyped] | Array[String]) record_ids) -> untyped
    def sum_blob_bytes_in_batches: (ActiveRecord::QueryMethods::WhereChain[ActiveStorage::Attachment::ActiveRecord_Relation] base_scope, (Array[Integer] | Array[String]) record_ids) -> untyped
  end
end
