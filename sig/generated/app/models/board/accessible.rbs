class Board
  module Accessible
    extend ActiveSupport::Concern
    def revise: (?granted: untyped, ?revoked: untyped) -> untyped
    def grant_to: (untyped users) -> untyped
    def revoke_from: (untyped users) -> untyped
    def accessed_by: (untyped user) -> untyped
    def access_for: (untyped user) -> (Access & Access::Validated)?
    def accessible_to?: (untyped user) -> (bool | false)
    def clean_inaccessible_data_for: (untyped user) -> untyped
    def watchers: () -> User::ActiveRecord_Relation

    private

    def grant_access_to_creator: () -> Access
    def grant_access_to_everyone: () -> untyped
    def mentions_for_user: (untyped user) -> untyped
    def notifications_for_user: (untyped user) -> untyped
    def watches_for: (untyped user) -> ActiveRecord::QueryMethods::WhereChain[Watch::ActiveRecord_Relation]
    def pins_for: (untyped user) -> ActiveRecord::QueryMethods::WhereChain[Pin::ActiveRecord_Relation]
  end
end
