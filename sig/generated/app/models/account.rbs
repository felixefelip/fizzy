class Account < ApplicationRecord
  include ::Account::Storage
  include Cancellable
  include Entropic
  include Incineratable
  include MultiTenantable
  include Searchable
  include Seedeable
  def create_with_owner: (account: { external_account_id: untyped, name: untyped }, owner: { name: untyped, identity: untyped }) -> untyped
  def slug: () -> String
  def account: () -> Account
  def system_user: () -> untyped
  def active?: () -> untyped
  def importing?: () -> untyped

  private

  def assign_external_account_id: () -> untyped
end
