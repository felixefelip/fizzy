class Account < ApplicationRecord
  include ::Account::Storage
  include Cancellable
  include Entropic
  include Incineratable
  include MultiTenantable
  include Searchable
  include Seedeable

  def self.create_with_owner: (account: { external_account_id: nil, name: String }, owner: { name: untyped, identity: (Identity & Identity::Validated)? }) -> self

  def slug: () -> String
  def account: () -> Account
  def system_user: () -> (User & User::Validated)
  def active?: () -> bool
  def importing?: () -> bool

  private

  def assign_external_account_id: () -> untyped
end
