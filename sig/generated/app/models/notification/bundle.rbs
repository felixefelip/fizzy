class Notification
  class Bundle < ApplicationRecord
    def self.deliver_all: () -> nil
    def self.deliver_all_later: () -> ActiveJob::Base

    def notifications: () -> Notification::ActiveRecord_Relation
    def deliver: () -> untyped
    def deliver_later: () -> ActiveJob::Base
    def flush: () -> ActiveJob::Base
    def set_default_window: () -> untyped

    private

    def window: () -> Range[ActiveSupport::TimeWithZone?]
    def validate_no_overlapping: () -> ActiveModel::Error?
    def deliverable?: () -> untyped
    def overlapping_bundles: () -> untyped
  end
end
