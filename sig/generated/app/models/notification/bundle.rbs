class Notification
  class Bundle < ApplicationRecord
    def deliver_all: () -> untyped
    def deliver_all_later: () -> untyped
    def notifications: () -> untyped
    def deliver: () -> untyped
    def deliver_later: () -> untyped
    def flush: () -> untyped
    def set_default_window: () -> untyped

    private

    def window: () -> untyped
    def validate_no_overlapping: () -> untyped
    def deliverable?: () -> untyped
    def overlapping_bundles: () -> untyped
  end
end
