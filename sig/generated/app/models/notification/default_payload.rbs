class Notification
  class DefaultPayload
    attr_reader notification: untyped

    def initialize: (untyped notification) -> untyped
    def to_h: () -> { body: "You have a new notification", title: "New notification", url: untyped }
    def title: () -> "New notification"
    def body: () -> "You have a new notification"
    def url: () -> untyped
    def category: () -> "default"
    def high_priority?: () -> false
    def base_url: () -> untyped
    def avatar_url: () -> untyped
    def card: () -> Card?

    private

    def card_url: (untyped card) -> untyped
    def notifications_url: () -> untyped
    def url_options: () -> untyped
  end
end
