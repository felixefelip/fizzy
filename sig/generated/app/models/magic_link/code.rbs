class MagicLink
  module Code
    def self.generate: (CODE_LENGTH length) -> untyped
    def self.sanitize: (untyped code) -> untyped
    def self.normalize_code: (untyped code) -> String
    def self.apply_substitutions: (untyped code) -> untyped
    def self.remove_invalid_characters: (untyped code) -> String
  end
end
