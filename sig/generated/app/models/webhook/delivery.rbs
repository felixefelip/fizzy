class Webhook
  class Delivery < ApplicationRecord
    @uri: URI::Generic?
    @payload: String?

    STALE_TRESHOLD: ActiveSupport::Duration
    USER_AGENT: String
    ENDPOINT_TIMEOUT: ActiveSupport::Duration
    MAX_RESPONSE_SIZE: untyped

    def self.cleanup: (?batch_size: untyped, ?pause: untyped) -> nil

    def deliver_later: () -> untyped
    def deliver: () -> untyped
    def sanitized_request: () -> Hash[Symbol, untyped]?
    def response_summary: () -> Hash[Symbol, untyped]?
    def failed?: () -> untyped
    def succeeded?: () -> untyped

    private

    def perform_request: () -> (Hash[Symbol, Symbol] | Hash[Symbol, Integer])
    def stream_body_with_limit: (Net::HTTPResponse response) -> String
    def resolved_ip: () -> untyped
    def uri: () -> URI::Generic
    def http: () -> Net::HTTP
    def headers: () -> Hash[String, untyped]
    def signature: () -> String
    def content_type: () -> String
    def payload: () -> String
    def render_payload: (**untyped) -> untyped
    def convert_html_to_mrkdwn: (untyped html) -> untyped
    def slack_payload: () -> String
    def base_url_options: () -> untyped
  end
end

class Webhook
  class Delivery
    class ResponseTooLarge < StandardError
    end
  end
end
