class Webhook
  class DelinquencyTracker < ApplicationRecord
    def record_delivery_of: (untyped delivery) -> untyped

    private

    def reset: () -> untyped
    def mark_first_failure_time: () -> untyped
    def delinquent?: () -> bool
    def failing_for_too_long?: () -> bool
    def too_many_consecutive_failures?: () -> bool
  end
end
