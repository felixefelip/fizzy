class User
  class DayTimeline
    class Column
      include ActionView::Helpers::TagHelper
      include ActionView::Helpers::OutputSafetyHelper
      include TimeHelper
      attr_reader index: untyped
      attr_reader id: untyped
      attr_reader base_title: untyped
      attr_reader day_timeline: User::DayTimeline
      attr_reader events: untyped
      def initialize: (User::DayTimeline day_timeline, untyped id, untyped base_title, untyped index, untyped events) -> void
      def title: () -> untyped
      def events_by_hour: () -> untyped
      def has_more_events?: () -> untyped
      def hidden_events_count: () -> untyped
      def to_param: () -> untyped

      private

      def limited_events: () -> untyped
      def full_events_count: () -> untyped
    end
  end
end
