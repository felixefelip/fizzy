class User
  class Settings < ApplicationRecord
    def bundle_aggregation_period: () -> ActiveSupport::Duration
    def bundling_emails?: () -> bool
    def timezone: () -> (ActiveSupport::TimeZone | User::Settings | nil)

    private

    def review_pending_bundles: () -> untyped
    def cancel_pending_bundles: () -> nil
    def flush_pending_bundles: () -> nil
    def default_timezone: () -> instance?
  end
end
