class User
  class Settings < ApplicationRecord
    def bundle_aggregation_period: () -> untyped
    def bundling_emails?: () -> untyped
    def timezone: () -> untyped

    private

    def review_pending_bundles: () -> untyped
    def cancel_pending_bundles: () -> untyped
    def flush_pending_bundles: () -> untyped
    def default_timezone: () -> untyped
  end
end
