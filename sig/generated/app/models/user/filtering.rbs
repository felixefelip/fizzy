class User
  class Filtering
    @boards: Board::ActiveRecord_Relation?
    @tags: Tag::ActiveRecord_Relation?
    @users: User::ActiveRecord_Relation?
    @filters: User_Filter::ActiveRecord_Associations_CollectionProxy?

    attr_reader user: (User & User::Validated)
    attr_reader filter: ((Filter & Filter::Validated) | Array[Filter])?
    attr_reader expanded: bool

    def initialize: ((User & User::Validated) user, ((Filter & Filter::Validated) | Array[Filter])? filter, ?expanded: bool) -> void
    def boards: () -> Board::ActiveRecord_Relation
    def selected_board_titles: () -> Array[String]
    def selected_boards_label: () -> untyped
    def tags: () -> Tag::ActiveRecord_Relation
    def users: () -> User::ActiveRecord_Relation
    def filters: () -> User_Filter::ActiveRecord_Associations_CollectionProxy
    def expanded?: () -> bool
    def any?: () -> untyped
    def show_indexed_by?: () -> untyped
    def show_sorted_by?: () -> untyped
    def show_tags?: () -> bool?
    def show_assignees?: () -> bool
    def show_creators?: () -> bool
    def show_closers?: () -> bool
    def show_boards?: () -> bool
    def single_board_or_first: () -> untyped
    def cache_key: () -> untyped
    def as_params: () -> Hash[untyped, untyped]
    def single_board: () -> (Board & Board::Validated)?
    def only_closed?: () -> untyped

    private

    def account: () -> (Account & Account::Validated)
  end
end
