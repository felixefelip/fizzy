class User
  module Mentionable
    extend ActiveSupport::Concern

    def mentioned_by: (untyped mentioner, at: untyped) -> (Mention & Mention::Validated)
    def mentionable_handles: () -> Array[untyped]
    def content_type: () -> String

    private

    def first_name_with_last_name_initial: () -> String
  end
end
