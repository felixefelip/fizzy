class User < ApplicationRecord
  include Accessor
  include Assignee
  include Attachable
  include Avatar
  include Configurable
  include EmailAddressChangeable
  include Mentionable
  include Named
  include Notifiable
  include Role
  include Searcher
  include Watcher
  include Timelined
  include ActionText::Attachable
  extend ActionText::Attachable::ClassMethods

  def deactivate: () -> untyped
  def setup?: () -> bool
  def verified?: () -> bool
  def verify: () -> self?
  def attachable_plain_text_representation: (**untyped) -> String
  def to_attachable_partial_path: () -> String
  def to_editor_content_attachment_partial_path: () -> String
  def admin?: () -> bool
  def timezone: () -> untyped?

  private

  def close_remote_connections: () -> untyped
end
