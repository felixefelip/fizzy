class User < ApplicationRecord
  include Accessor
  include Assignee
  include Attachable
  include Avatar
  include Configurable
  include EmailAddressChangeable
  include Mentionable
  include Named
  include Notifiable
  include Role
  include Searcher
  include Watcher
  include Timelined
  def deactivate: () -> untyped
  def setup?: () -> bool
  def verified?: () -> (bool | false)
  def verify: () -> self?

  private

  def close_remote_connections: () -> untyped
end
