class Comment < ApplicationRecord
  include Attachments
  include Eventable
  include Mentions
  include Promptable
  include Searchable
  include Storage::Tracked
  include ::Mentions
  include ::Searchable

  def to_partial_path: () -> String
  def mentionable?: () -> bool
  def publicly_accessible?: () -> untyped
  def accessible_to?: (User & User::Validated user) -> bool
  def board: () -> Board?
  def watch_by: (User? user) -> untyped

  private

  def card_is_commentable: () -> ActiveModel::Error?
  def watch_card_by_creator: () -> untyped
end
