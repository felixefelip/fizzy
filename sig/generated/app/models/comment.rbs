class Comment < ApplicationRecord
  include Attachments
  include Eventable
  include Mentions
  include Promptable
  include Searchable
  include Storage::Tracked
  include ::Mentions
  include ::Searchable

  def to_partial_path: () -> String
  def body: () -> ActionText::RichText
  def body?: () -> bool
  def body=: (untyped body) -> ActionText::RichText
  def mentionable?: () -> bool
  def publicly_accessible?: () -> untyped
  def accessible_to?: (User? | (User & User::Validated) user) -> bool
  def board: () -> Board?
  def watch_by: (User & User::Validated user) -> untyped

  private

  def card_is_commentable: () -> ActiveModel::Error?
  def watch_card_by_creator: () -> untyped

  class AfterBody
    def rich_text_body: () -> ::ActionText::RichText
  end
end
