class Notification < ApplicationRecord
  include ::Notification::Pushable
  def self.read_all: () -> Notification::ActiveRecord_Relation
  def self.unread_all: () -> Notification::ActiveRecord_Relation
  def read: () -> untyped
  def unread: () -> untyped
  def read?: () -> untyped
  def notifiable_target: () -> untyped
  def identity: () -> Identity?

  private

  def set_card: () -> untyped
  def bundle: () -> untyped
  def broadcast_update: () -> untyped
end
