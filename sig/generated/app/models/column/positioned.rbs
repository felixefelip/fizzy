class Column
  module Positioned
    extend ActiveSupport::Concern
    def move_left: () -> untyped
    def move_right: () -> untyped
    def left_column: () -> (Column & Column::Validated)?
    def right_column: () -> (Column & Column::Validated)?
    def leftmost?: () -> false
    def rightmost?: () -> false
    def adjacent_columns: () -> Column::ActiveRecord_Associations_CollectionProxy

    private

    def set_position: () -> untyped
    def swap_position_with: (untyped other_column) -> untyped
  end
end
