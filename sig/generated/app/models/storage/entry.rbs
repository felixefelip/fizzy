module Storage
  class Entry < ApplicationRecord
    def self.suppressing_recording: () { () -> untyped } -> untyped
    def self.record: (delta: Integer?, operation: ("reconcile" | "transfer_out" | "transfer_in" | "attach" | "detach"), account: Account & Account::Validated, ?board: (self? | (Board & Board::Validated))?, ?recordable: nil?, ?blob: (ActiveStorage::Blob & ActiveStorage::Blob::Validated)?) -> self?
  end
end
