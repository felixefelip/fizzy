module Storage
  module AttachmentTracking
    @storage_snapshot: { account: untyped, board: untyped, recordable: untyped }?

    extend ActiveSupport::Concern

    private

    def record_storage_attach: () -> self?
    def record_storage_detach: () -> self?
    def snapshot_storage_context: () -> { account: untyped, board: untyped, recordable: untyped }?
    def storage_tracked_record: () -> untyped
  end
end
