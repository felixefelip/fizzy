class MagicLink < ApplicationRecord
  CODE_LENGTH: Integer
  EXPIRATION_TIME: ActiveSupport::Duration

  def self.consume: (untyped code) -> MagicLink?
  def self.cleanup: () -> untyped

  def consume: () -> MagicLink

  private

  def generate_code: () -> String
  def set_expiration: () -> ActiveSupport::TimeWithZone
end
