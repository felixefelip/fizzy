class Current < ActiveSupport::CurrentAttributes
  def session=: ((Session & Session::Validated) value) -> untyped
  def identity=: (Identity identity) -> (User & User::Validated)?
  def with_account: (Account? value) ?{ (*untyped) -> bool } -> untyped
  def without_account: () ?{ (*untyped) -> untyped } -> untyped
end
