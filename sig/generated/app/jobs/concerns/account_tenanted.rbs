module AccountTenanted
  @account: (Account & Account::Validated)?

  extend ActiveSupport::Concern

  def initialize: (**untyped) -> void
  def serialize: () -> Hash[String, untyped]
  def deserialize: (untyped job_data) -> untyped

  private

  def with_account_context: () { () -> untyped } -> untyped
  def resolve_account!: () -> untyped
end
