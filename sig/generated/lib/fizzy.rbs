module Fizzy
  self.@db_adapter: DbAdapter?

  def self.saas?: () -> bool
  def self.db_adapter: () -> Fizzy::DbAdapter
  def self.configure_bundle: () -> String?
end

module Fizzy
  class DbAdapter
    @name: String

    def initialize: (String name) -> void
    def to_s: () -> String
