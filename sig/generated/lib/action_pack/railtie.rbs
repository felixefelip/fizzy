module ActionPack
  class Railtie < Rails::Railtie
  end
end

module ActionPack
  class Railtie
    module ActiveRecord
      class Base
        include ::ActionPack::Passkey::Holder
        extend ::ActionPack::Passkey::Holder::ClassMethods

        def self.has_passkeys: (**untyped) ?{ (*untyped) -> untyped } -> untyped
      end
    end
  end
end

module ActionPack
  class Railtie
    module ActionView
      class Base
        include ::ActionPack::Passkey::FormHelper
      end
    end
  end
end

module ActionPack
  class Railtie
    module ActionController
      class Base
      end
    end
  end
end
