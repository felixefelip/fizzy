module ActionPack
  class Passkey
    module Request
      extend ActiveSupport::Concern
      def passkey_registration_params: (?param: untyped) -> untyped
      def passkey_authentication_params: (?param: untyped) -> untyped
      def passkey_authentication_options: (**untyped) -> untyped
      def passkey_registration_options: (**untyped) -> untyped
    end
  end
end
