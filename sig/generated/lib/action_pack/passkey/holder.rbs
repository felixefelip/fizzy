module ActionPack
  class Passkey
    module Holder
      @registration_options: (Proc | ^(untyped) -> untyped)?
      @authentication_options: (Proc | ^(untyped) -> untyped)?

      module ClassMethods
        def has_passkeys: (**untyped) ?{ (untyped) -> untyped } -> untyped
      end

      extend ActiveSupport::Concern
    end
  end
end

module ActionPack
  class Passkey
    module Holder
      class Config
        @registration_options: (Proc | ^(untyped) -> untyped)?
        @authentication_options: (Proc | ^(untyped) -> untyped)?

        attr_accessor association_name: untyped
        attr_accessor dependent: untyped

        def initialize: (**untyped) -> untyped
        def authentication_options: () ?{ (untyped) -> untyped } -> nil
        def registration_options: () ?{ (untyped) -> untyped } -> nil
        def evaluate_authentication_options: (ActionPack::Passkey::Holder record) -> Hash[untyped, untyped]
        def evaluate_registration_options: (ActionPack::Passkey::Holder record) -> Hash[untyped, untyped]

        private

        def extract_options_for: ((singleton(ActionPack::WebAuthn::PublicKeyCredential::CreationOptions) | singleton(ActionPack::WebAuthn::PublicKeyCredential::RequestOptions)) klass, Hash[Symbol, untyped] options) -> Hash[Symbol, untyped]?
        def options_to_proc: (Hash[Symbol, untyped] options) -> Proc
      end
    end
  end
end
