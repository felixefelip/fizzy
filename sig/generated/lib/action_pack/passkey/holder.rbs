module ActionPack
  class Passkey
    module Holder
      @registration_options: Proc?
      @authentication_options: Proc?
      module ClassMethods
        def has_passkeys: (**untyped) ?{ (untyped) -> untyped } -> untyped
      end
      extend ActiveSupport::Concern
      attr_accessor association_name: untyped
      attr_accessor dependent: untyped
      def initialize: (**untyped) -> untyped
      def authentication_options: () ?{ (untyped) -> untyped } -> nil
      def registration_options: () ?{ (untyped) -> untyped } -> nil
      def evaluate_authentication_options: (untyped record) -> Hash[untyped, untyped]
      def evaluate_registration_options: (untyped record) -> Hash[untyped, untyped]

      private

      def extract_options_for: ((singleton(ActionPack::WebAuthn::PublicKeyCredential::CreationOptions) | singleton(ActionPack::WebAuthn::PublicKeyCredential::RequestOptions)) klass, untyped options) -> untyped
      def options_to_proc: (untyped options) -> Proc
    end
  end
end
