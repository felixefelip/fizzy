module ActionPack
  module WebAuthn
    class CoseKey
      P256_COORDINATE_LENGTH: 32
      MINIMUM_RSA_KEY_BITS: 2048
      KEY_TYPE_LABEL: 1
      ALGORITHM_LABEL: 3
      EC2_CURVE_LABEL: -1
      EC2_X_LABEL: -2
      EC2_Y_LABEL: -3
      RSA_N_LABEL: -1
      RSA_E_LABEL: -2
      OKP_CURVE_LABEL: -1
      OKP_X_LABEL: -2
      OKP: 1
      EC2: 2
      RSA: 3
      ES256: -7
      EDDSA: -8
      RS256: -257
      P256: 1
      ED25519: 6
      UNCOMPRESSED_POINT_MARKER: 4

      def self.decode: (nil bytes) -> ActionPack::WebAuthn::CoseKey

      attr_reader key_type: untyped
      attr_reader algorithm: untyped
      attr_reader parameters: untyped

      def initialize: (key_type: untyped, algorithm: untyped, parameters: untyped) -> untyped
      def to_openssl_key: () -> OpenSSL::PKey::PKey

      private

      def build_ec2_es256_key: () -> OpenSSL::PKey::EC
      def build_okp_eddsa_key: () -> OpenSSL::PKey::PKey
      def build_rsa_rs256_key: () -> OpenSSL::PKey::RSA
    end
  end
end
