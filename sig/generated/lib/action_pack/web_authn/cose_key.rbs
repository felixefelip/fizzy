module ActionPack
  module WebAuthn
    class CoseKey
      def self.decode: (nil bytes) -> self
      attr_reader key_type: untyped
      attr_reader algorithm: untyped
      attr_reader parameters: untyped
      def initialize: (key_type: untyped, algorithm: untyped, parameters: untyped) -> untyped
      def to_openssl_key: () -> OpenSSL::PKey::PKey

      private

      def build_ec2_es256_key: () -> OpenSSL::PKey::EC
      def build_okp_eddsa_key: () -> OpenSSL::PKey::PKey
      def build_rsa_rs256_key: () -> OpenSSL::PKey::RSA
    end
  end
end
