module ActionPack
  module WebAuthn
    class CborDecoder
      @position: Integer
      @depth: Integer
      UNSIGNED_INTEGER_TYPE: Integer
      NEGATIVE_INTEGER_TYPE: Integer
      BYTE_STRING_TYPE: Integer
      TEXT_STRING_TYPE: Integer
      ARRAY_TYPE: Integer
      MAP_TYPE: Integer
      TAG_TYPE: Integer
      FLOAT_OR_SIMPLE_TYPE: Integer
      SIMPLE_VALUE_RANGE: untyped
      SINGLE_BYTE_VALUE_FOLLOWS: Integer
      TWO_BYTE_VALUE_FOLLOWS: Integer
      FOUR_BYTE_VALUE_FOLLOWS: Integer
      EIGHT_BYTE_VALUE_FOLLOWS: Integer
      RESERVED_VALUE_RANGE: untyped
      INDEFINITE_LENGTH_MAJOR_TYPE: Integer
      SIMPLE_FALSE_VALUE: Integer
      SIMPLE_TRUE_VALUE: Integer
      SIMPLE_NULL_VALUE: Integer
      SIMPLE_UNDEFINED_VALUE: Integer
      BREAK_CODE: Integer
      MAX_DEPTH: Integer
      MAX_SIZE: untyped
      POSITIVE_BIGNUM_TAG: Integer
      NEGATIVE_BIGNUM_TAG: Integer
      def self.decode: (untyped bytes, **untyped) -> (BigDecimal | String | Array[untyped] | Hash[untyped, untyped] | bool | nil | Float)
      def initialize: (untyped bytes, ?max_depth: MAX_DEPTH, ?max_size: untyped) -> Integer
      def decode: () -> untyped

      private

      def major_type: () -> untyped
      def peek: () -> untyped
      def decode_unsigned_integer: () -> untyped
      def decode_negative_integer: () -> untyped
      def decode_byte_string: () -> untyped
      def decode_text_string: () -> untyped
      def decode_array: () -> untyped
      def decode_map: () -> untyped
      def decode_float_or_simple: () -> untyped
      def decode_tag: () -> untyped
      def decode_half_float: () -> untyped
      def read_argument: () -> untyped
      def additional_info: (?consume: bool) -> untyped
      def indefinite_length?: () -> untyped
      def break_code?: () -> untyped
      def read_bytes: (Integer length) -> untyped
      def read_byte: () -> untyped
    end
  end
end
