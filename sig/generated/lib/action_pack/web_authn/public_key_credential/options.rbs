module ActionPack
  module WebAuthn
    class PublicKeyCredential
      class Options
        CHALLENGE_LENGTH: Integer
        USER_VERIFICATION_OPTIONS: untyped
        include ActiveModel::API
        include ActiveModel::Attributes
        extend ActiveModel::Attributes::ClassMethods
        def initialize: (?Hash[untyped, untyped] attributes) -> void
        def validate!: () -> untyped
        def inspect: () -> String
        def challenge: () -> untyped
      end
    end
  end
end
