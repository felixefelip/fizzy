module ActionPack
  module WebAuthn
    class PublicKeyCredential
      class Options
        @challenge: String?

        CHALLENGE_LENGTH: 32
        USER_VERIFICATION_OPTIONS: Array[Symbol]

        include ActiveModel::API
        include ActiveModel::Attributes

        def initialize: (?Hash[untyped, untyped] attributes) -> void
        def validate!: () -> true
        def inspect: () -> String
        def challenge: () -> String
      end
    end
  end
end
