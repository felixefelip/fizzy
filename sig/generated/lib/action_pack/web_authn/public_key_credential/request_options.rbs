module ActionPack
  module WebAuthn
    class PublicKeyCredential
      class RequestOptions < ::ActionPack::WebAuthn::PublicKeyCredential::Options
        def initialize: (?Hash[untyped, untyped] attributes) -> untyped
        def as_json: (?Hash[untyped, untyped] options) -> untyped

        private

        def allow_credential_json: (untyped credential) -> untyped
      end
    end
  end
end
