module ActionPack
  module WebAuthn
    module Authenticator
      class AssertionResponse < ::ActionPack::WebAuthn::Authenticator::Response
        attr_reader credential: ActionPack::WebAuthn::PublicKeyCredential
        attr_reader authenticator_data: ActionPack::WebAuthn::Authenticator::Data
        attr_reader signature: String
        def initialize: (credential: ActionPack::WebAuthn::PublicKeyCredential, authenticator_data: ActionPack::WebAuthn::Authenticator::Data, signature: String, **untyped) -> void

        private

        def challenge_purpose: () -> String
        def client_data_type_must_be_get: () -> ActiveModel::Error?
        def signature_must_be_valid: () -> ActiveModel::Error?
        def sign_count_must_increase: () -> ActiveModel::Error?
        def sign_count_increased?: () -> bool

        class AfterInitialize
          attr_reader authenticator_data: singleton(ActionPack::WebAuthn::Authenticator::Data)
        end
      end
    end
  end
end
