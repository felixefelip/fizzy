module ActionPack
  module WebAuthn
    module Authenticator
      class AssertionResponse < ::ActionPack::WebAuthn::Authenticator::Response
        attr_reader credential: ActionPack::WebAuthn::PublicKeyCredential
        attr_reader authenticator_data: ActionPack::WebAuthn::Authenticator::Data
        attr_reader signature: Base64
        def initialize: (credential: ActionPack::WebAuthn::PublicKeyCredential, authenticator_data: ActionPack::WebAuthn::Authenticator::Data, signature: Base64, **untyped) -> void

        private

        def challenge_purpose: () -> String
        def client_data_type_must_be_get: () -> untyped
        def signature_must_be_valid: () -> untyped
        def sign_count_must_increase: () -> untyped
        def sign_count_increased?: () -> untyped
      end
    end
  end
end
