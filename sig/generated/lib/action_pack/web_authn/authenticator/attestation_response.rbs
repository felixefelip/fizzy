module ActionPack
  module WebAuthn
    module Authenticator
      class AttestationResponse < ::ActionPack::WebAuthn::Authenticator::Response
        attr_reader attestation_object: untyped
        def initialize: (attestation_object: untyped, **untyped) -> void
        def attestation: () -> untyped
        def authenticator_data: () -> untyped

        private

        def challenge_purpose: () -> String
        def client_data_type_must_be_create: () -> untyped
        def attestation_must_be_valid: () -> untyped
      end
    end
  end
end
