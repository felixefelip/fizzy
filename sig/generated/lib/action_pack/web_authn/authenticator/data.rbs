module ActionPack
  module WebAuthn
    module Authenticator
      class Data
        @public_key: OpenSSL::PKey::PKey?

        RELYING_PARTY_ID_HASH_LENGTH: 32
        FLAGS_LENGTH: 1
        SIGN_COUNT_LENGTH: 4
        AAGUID_LENGTH: 16
        CREDENTIAL_ID_LENGTH_BYTES: 2
        USER_PRESENT_FLAG: 1
        USER_VERIFIED_FLAG: 4
        BACKUP_ELIGIBLE_FLAG: 8
        BACKUP_STATE_FLAG: 16
        ATTESTED_CREDENTIAL_DATA_FLAG: 64

        def self.wrap: (ActionPack::WebAuthn::Authenticator::Data data) -> self
        def self.decode: ((ActionPack::WebAuthn::Authenticator::Data | String) bytes) -> ActionPack::WebAuthn::Authenticator::Data

        attr_reader bytes: untyped
        attr_reader relying_party_id_hash: untyped
        attr_reader flags: untyped
        attr_reader sign_count: untyped
        attr_reader aaguid: nil
        attr_reader credential_id: String
        attr_reader public_key_bytes: nil

        def initialize: (bytes: untyped, relying_party_id_hash: untyped, flags: untyped, sign_count: untyped, ?aaguid: nil?, credential_id: String, public_key_bytes: nil) -> void
        def user_present?: () -> untyped
        def user_verified?: () -> untyped
        def backup_eligible?: () -> untyped
        def backed_up?: () -> untyped
        def public_key: () -> OpenSSL::PKey::PKey?
      end
    end
  end
end
