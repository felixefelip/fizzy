module ActionPack
  module WebAuthn
    module Authenticator
      class Data
        RELYING_PARTY_ID_HASH_LENGTH: Integer
        FLAGS_LENGTH: Integer
        SIGN_COUNT_LENGTH: Integer
        AAGUID_LENGTH: Integer
        CREDENTIAL_ID_LENGTH_BYTES: Integer
        USER_PRESENT_FLAG: Integer
        USER_VERIFIED_FLAG: Integer
        BACKUP_ELIGIBLE_FLAG: Integer
        BACKUP_STATE_FLAG: Integer
        ATTESTED_CREDENTIAL_DATA_FLAG: Integer

        def self.wrap: (self data) -> self
        def self.decode: (String bytes) -> self

        attr_reader bytes: untyped
        attr_reader relying_party_id_hash: untyped
        attr_reader flags: untyped
        attr_reader sign_count: untyped
        attr_reader aaguid: nil
        attr_reader credential_id: String
        attr_reader public_key_bytes: nil

        def initialize: (bytes: untyped, relying_party_id_hash: untyped, flags: untyped, sign_count: untyped, ?aaguid: nil?, credential_id: String, public_key_bytes: nil) -> void
        def user_present?: () -> untyped
        def user_verified?: () -> untyped
        def backup_eligible?: () -> untyped
        def backed_up?: () -> untyped
        def public_key: () -> untyped
      end
    end
  end
end
