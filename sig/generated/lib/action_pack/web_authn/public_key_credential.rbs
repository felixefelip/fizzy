module ActionPack
  module WebAuthn
    class PublicKeyCredential
      attr_reader id: String?
      attr_reader public_key: String?
      attr_reader sign_count: Integer?
      attr_reader aaguid: untyped
      attr_reader backed_up: untyped
      attr_reader transports: Array[untyped]?
      def request_options: (**untyped) -> ActionPack::WebAuthn::PublicKeyCredential::RequestOptions
      def creation_options: (**untyped) -> ActionPack::WebAuthn::PublicKeyCredential::CreationOptions
      def register: (untyped params, ?origin: untyped) -> self

      private

      def transform_credentials: (untyped credentials) -> Array[untyped]
      def initialize: (id: String?, public_key: String?, sign_count: Integer?, ?aaguid: String?, ?backed_up: untyped, ?transports: Array[untyped]?) -> void
      def authenticate: (untyped params, ?origin: untyped) -> untyped
      def to_h: () -> { aaguid: untyped, backed_up: untyped, credential_id: String?, public_key: untyped, sign_count: Integer?, transports: Array[untyped]? }

      class AfterInitialize
        attr_reader aaguid: String?
      end
    end
  end
end
