class AutoLinkScrubber < Loofah::Scrubber
  @direction: Symbol

  EXCLUDED_ELEMENTS: Array[String]
  EMAIL_AUTOLINK_REGEXP: Regexp
  URL_REGEXP: Regexp
  AUTOLINK_REGEXP: Regexp
  TRAILING_PUNCTUATION: ".?,:!;\"'<>"
  TRAILING_PUNCTUATION_REGEXP: Regexp
  MAX_TEXT_NODE_LENGTH: 10000

  def initialize: () -> :top_down
  def scrub: (untyped node) -> Object

  private

  def autolink_text_node: (untyped node) -> Nokogiri::XML::NodeSet?
  def find_links: (untyped text) -> Array[untyped]
  def clean_url: (String url) -> String
end
