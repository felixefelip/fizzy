class Board
  def save: (**untyped) -> bool
  def run_before_validation_callbacks: () -> untyped
  def run_belongs_to_default_callbacks: () -> untyped
  def run_belongs_to_default_creator: () -> (User | (User & User::Validated) | nil)
  def run_belongs_to_default_account: () -> untyped
  def accesses: () -> Board_Access::ActiveRecord_Associations_CollectionProxy
  def users: () -> Board_User::ActiveRecord_Associations_CollectionProxy
  def access_only_users: () -> Board_User::ActiveRecord_Associations_CollectionProxy
  def storage_entries: () -> Board_Storage_Entry::ActiveRecord_Associations_CollectionProxy
  def cards: () -> Board_Card::ActiveRecord_Associations_CollectionProxy
  def columns: () -> Board_Column::ActiveRecord_Associations_CollectionProxy
  def tags: () -> Board_Tag::ActiveRecord_Associations_CollectionProxy
  def events: () -> Board_Event::ActiveRecord_Associations_CollectionProxy
  def webhooks: () -> Board_Webhook::ActiveRecord_Associations_CollectionProxy
end
