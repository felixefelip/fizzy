module ActiveSupport
  module Concern
    @_included_block: (^(*untyped) -> untyped)?

    def self.extended: (untyped base) -> untyped | ...

    def append_features: (untyped base) -> bool? | ...
    def class_methods: () ?{ (*untyped) -> Symbol } -> untyped | ...
    def included: (?untyped base) ?{ (*untyped) -> (Module | Symbol | self | Array[Class] | nil) } -> (^() -> untyped)? | ...
  end
end
