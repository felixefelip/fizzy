module ActiveSupport
  module Concern
    @_included_block: (^(*untyped) -> untyped)?

    def self.extended: (Object base) -> untyped | ...

    def append_features: (Module base) -> bool? | ...
    def class_methods: () ?{ (*untyped) -> Symbol } -> untyped | ...
    def included: (?Module? base) ?{ (*untyped) -> (self | Symbol | Array[Class] | nil) } -> (^() -> untyped)? | ...
  end
end
