class ERBLayoutsApplication
  include ActionViewContext

  def initialize: (body_class: untyped, header_class: untyped, hide_footer_frames: untyped, page_title: untyped) -> untyped
  def render: (?("layouts/shared/head" | "my/menu" | "layouts/shared/flash" | "layouts/shared/time_zone" | "bar/bar" | "my/pins/tray" | "notifications/tray" | "layouts/shared/welcome_letter")? target, *untyped rest) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil
end
