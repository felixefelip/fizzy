class ERBEventsIndex
  @day_timeline: User::DayTimeline
  @filter: (Filter & Filter::Validated) | Filter
  @user_filtering: User::Filtering

  include ActionViewContext
  include EventsHelper

  def initialize: (day_timeline: User::DayTimeline, filter: (::Filter & ::Filter::Validated | ::Filter), user_filtering: User::Filtering) -> void
