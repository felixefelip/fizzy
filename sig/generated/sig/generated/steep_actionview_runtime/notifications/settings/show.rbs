class ERBNotificationsSettingsShow
  @boards: Board::ActiveRecord_Relation
  @settings: User::Settings?

  include ActionViewContext

  def initialize: (boards: Board::ActiveRecord_Relation, page_title: untyped, settings: User::Settings?) -> void
