class ERBPartialEntropyAutoClose
  include ActionViewContext

  def initialize: (disabled: bool, model: (Entropy? | Board & Board::Validated), url: String) -> void
  def render: (?"entropy/knob"? target, *{ form: ActionView::Helpers::FormBuilder, name: :auto_postpone_period_in_days, current_value: Integer, knob_options: Array[Integer], label: "Days until auto-close", disabled: untyped } rest) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil

  private

  attr_reader disabled: bool
  attr_reader model: (Entropy? | Board & Board::Validated)
  attr_reader url: String

  class AfterInitialize
    attr_reader model: (Entropy | (Board & Board::Validated))?
  end
end
