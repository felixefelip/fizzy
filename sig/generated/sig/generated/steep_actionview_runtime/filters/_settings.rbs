class ERBPartialFiltersSettings
  include ActionViewContext

  def initialize: (filter_url: untyped, no_filtering_url: untyped, user_filtering: User::Filtering) -> void
  def render: (?String target, *untyped) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil

  private

  attr_reader filter_url: untyped
  attr_reader no_filtering_url: untyped
  attr_reader user_filtering: User::Filtering
end
