class ERBPartialFiltersSettingsControls
  include ActionViewContext

  def initialize: (form: untyped, user_filtering: User::Filtering) -> void
  def render: (?("filters/settings/boards" | "filters/settings/sorted_by" | "filters/settings/indexed_by" | "filters/settings/tags" | "filters/settings/assignees" | "filters/settings/creators" | "filters/settings/closers")? target, *{ user_filtering: User::Filtering } rest) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil

  private

  attr_reader form: untyped
  attr_reader user_filtering: User::Filtering
end
