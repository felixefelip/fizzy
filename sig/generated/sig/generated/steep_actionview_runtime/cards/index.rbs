class ERBCardsIndex
  @filter: (Filter & Filter::Validated) | Filter
  @user_filtering: User::Filtering

  include ActionViewContext
  include CardsHelper

  def initialize: (filter: (::Filter & ::Filter::Validated | ::Filter), page: untyped, user_filtering: User::Filtering) -> void
  def render: (?("cards/broadcasts" | "filters/settings" | "cards/display/previews")? target, *({ filter: (Filter & Filter::Validated) | Filter } | { filter_url: untyped, user_filtering: User::Filtering, no_filtering_url: untyped } | { cards: untyped, draggable: true }) rest) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil
end
