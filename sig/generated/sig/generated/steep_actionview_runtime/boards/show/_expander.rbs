class ERBPartialBoardsShowExpander
  include ActionViewContext

  def initialize: (column_id: ("closed-cards" | "not-now" | "maybe"), count: Integer, title: ("Done" | "Not Now" | "Maybe?" | String?)) -> void
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil

  private

  attr_reader column_id: ("closed-cards" | "not-now" | "maybe")
  attr_reader count: Integer
  attr_reader title: ("Done" | "Not Now" | "Maybe?" | String?)

  class AfterInitialize
    attr_reader title: ("Done" | "Not Now" | "Maybe?" | String)?
  end
end
