class ERBPartialBoardsShowStream
  include ActionViewContext

  def initialize: (board: (Board | (Board & Board::Validated))?, page: untyped) -> void
  def render: (?String? target, *({ title: String, count: Integer, column_id: String } | { column_path: untyped } | { board: (Board | (Board & Board::Validated))? } | { cards: untyped, draggable: bool }) rest) -> nil
  def params: () -> ActionController::Parameters
  def __rbs_infer__body: () -> nil

  private

  attr_reader board: (Board | (Board & Board::Validated))?
  attr_reader page: untyped
end
