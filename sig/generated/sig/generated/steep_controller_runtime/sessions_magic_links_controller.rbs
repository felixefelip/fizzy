    def render: (?(:show | { json: { message: String }, status: :unauthorized } | { json: { session_token: untyped, requires_signup_completion: bool } } | { json: { message: "Try another code." }, status: :unauthorized } | { json: { message: String }, status: :too_many_requests })? target, *untyped rest) -> true

    private

